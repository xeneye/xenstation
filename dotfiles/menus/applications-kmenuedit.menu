<!DOCTYPE Menu PUBLIC '-//freedesktop//DTD Menu 1.0//EN' 'http://www.freedesktop.org/standards/menu-spec/menu-1.0.dtd'>
<Menu>
 <Menu>
  <Name>Development</Name>
  <Layout>
   <Merge type="menus"/>
   <Menuname>Translation</Menuname>
   <Menuname>Web Development</Menuname>
  </Layout>
  <Exclude>
   <Filename>nvim.desktop</Filename>
   <Filename>org.kde.kate.desktop</Filename>
  </Exclude>
 </Menu>
 <Menu>
  <Name>Education</Name>
  <Menu>
   <Name>Mathematics</Name>
   <Layout/>
   <Exclude>
    <Filename>math.desktop</Filename>
   </Exclude>
  </Menu>
  <Menu>
   <Name>Science</Name>
   <Layout/>
   <Exclude>
    <Filename>math.desktop</Filename>
   </Exclude>
  </Menu>
 </Menu>
 <Menu>
  <Name>Graphics</Name>
  <Layout>
   <Merge type="menus"/>
   <Menuname>More</Menuname>
   <Merge type="files"/>
   <Filename>blender.desktop</Filename>
   <Filename>org.kde.kcolorchooser.desktop</Filename>
   <Filename>gimp.desktop</Filename>
   <Filename>org.kde.gwenview.desktop</Filename>
   <Filename>org.kde.spectacle.desktop</Filename>
  </Layout>
  <Menu>
   <Name>More</Name>
   <Layout/>
   <Exclude>
    <Filename>org.kde.kcolorchooser.desktop</Filename>
   </Exclude>
  </Menu>
  <Include>
   <Filename>org.kde.kcolorchooser.desktop</Filename>
   <Filename>org.kde.spectacle.desktop</Filename>
  </Include>
  <Exclude>
   <Filename>org.kde.skanlite.desktop</Filename>
   <Filename>davinci-resolve.desktop</Filename>
   <Filename>draw.desktop</Filename>
   <Filename>org.kde.okular.desktop</Filename>
  </Exclude>
 </Menu>
 <Menu>
  <Name>Help</Name>
  <Layout/>
  <Exclude>
   <Filename>org.kde.kinfocenter.desktop</Filename>
  </Exclude>
 </Menu>
 <Menu>
  <Name>Internet</Name>
  <Layout>
   <Merge type="menus"/>
   <Menuname>More</Menuname>
   <Menuname>Terminal</Menuname>
   <Merge type="files"/>
   <Filename>brave-browser.desktop</Filename>
   <Filename>filezilla.desktop</Filename>
   <Filename>syncthing-ui.desktop</Filename>
  </Layout>
  <Exclude>
   <Filename>steam.desktop</Filename>
   <Filename>remote-viewer.desktop</Filename>
  </Exclude>
 </Menu>
 <Menu>
  <Name>Multimedia</Name>
  <Layout>
   <Merge type="menus"/>
   <Menuname>More</Menuname>
   <Merge type="files"/>
   <Filename>org.audacityteam.Audacity.desktop</Filename>
   <Filename>davinci-resolve.desktop</Filename>
   <Filename>media-downloader.desktop</Filename>
   <Filename>noisetorch.desktop</Filename>
   <Filename>com.obsproject.Studio.desktop</Filename>
   <Filename>vlc.desktop</Filename>
  </Layout>
  <Exclude>
   <Filename>blackmagicraw-player.desktop</Filename>
   <Filename>blackmagicraw-speedtest.desktop</Filename>
   <Filename>davinci-fairlight-studio-utility.desktop</Filename>
  </Exclude>
 </Menu>
 <Menu>
  <Name>Office</Name>
  <Layout>
   <Merge type="files"/>
   <Filename>startcenter.desktop</Filename>
   <Filename>base.desktop</Filename>
   <Filename>calc.desktop</Filename>
   <Filename>draw.desktop</Filename>
   <Filename>impress.desktop</Filename>
   <Filename>math.desktop</Filename>
   <Filename>writer.desktop</Filename>
   <Filename>org.kde.okular.desktop</Filename>
   <Filename>org.kde.skanlite.desktop</Filename>
   <Separator/>
   <Merge type="menus"/>
   <Menuname>More</Menuname>
  </Layout>
  <Include>
   <Filename>startcenter.desktop</Filename>
   <Filename>base.desktop</Filename>
   <Filename>org.kde.skanlite.desktop</Filename>
  </Include>
  <Exclude/>
 </Menu>
 <Menu>
  <Name>System</Name>
  <Layout>
   <Merge type="menus"/>
   <Menuname>More</Menuname>
   <Menuname>ScreenSavers</Menuname>
   <Menuname>Terminal</Menuname>
   <Merge type="files"/>
   <Filename>org.kde.dolphin.desktop</Filename>
   <Filename>org.kde.kinfocenter.desktop</Filename>
   <Filename>org.kde.konsole.desktop</Filename>
   <Filename>org.kde.kmenuedit.desktop</Filename>
   <Filename>org.kde.kwalletmanager.desktop</Filename>
   <Filename>cups.desktop</Filename>
   <Filename>system-config-printer.desktop</Filename>
   <Filename>org.kde.plasma-systemmonitor.desktop</Filename>
   <Filename>systemsettings.desktop</Filename>
   <Filename>virt-manager.desktop</Filename>
  </Layout>
  <Exclude>
   <Filename>nixos-manual.desktop</Filename>
   <Filename>nvidia-settings.desktop</Filename>
   <Filename>nvtop.desktop</Filename>
   <Filename>org.kde.drkonqi.coredump.gui.desktop</Filename>
   <Filename>davinci-control-panels-setup.desktop</Filename>
  </Exclude>
  <Include>
   <Filename>org.kde.kmenuedit.desktop</Filename>
  </Include>
 </Menu>
 <Menu>
  <Name>Utilities</Name>
  <Layout>
   <Merge type="menus"/>
   <Menuname>More</Menuname>
   <Menuname>XUtilities</Menuname>
   <Merge type="files"/>
   <Filename>org.kde.ark.desktop</Filename>
   <Filename>espanso.desktop</Filename>
   <Filename>org.kde.kate.desktop</Filename>
   <Filename>remote-viewer.desktop</Filename>
  </Layout>
  <Include>
   <Filename>remote-viewer.desktop</Filename>
  </Include>
  <Exclude>
   <Filename>org.kde.spectacle.desktop</Filename>
   <Filename>org.kde.plasma.emojier.desktop</Filename>
   <Filename>org.kde.kwrite.desktop</Filename>
   <Filename>nvim.desktop</Filename>
   <Filename>noisetorch.desktop</Filename>
  </Exclude>
 </Menu>
 <Menu>
  <Name>.hidden</Name>
  <Include>
   <Filename>org.kde.kate.desktop</Filename>
   <Filename>math.desktop</Filename>
   <Filename>org.kde.kinfocenter.desktop</Filename>
   <Filename>steam.desktop</Filename>
   <Filename>davinci-resolve.desktop</Filename>
   <Filename>draw.desktop</Filename>
   <Filename>org.kde.okular.desktop</Filename>
   <Filename>nixos-manual.desktop</Filename>
   <Filename>nvidia-settings.desktop</Filename>
   <Filename>nvtop.desktop</Filename>
   <Filename>blackmagicraw-player.desktop</Filename>
   <Filename>blackmagicraw-speedtest.desktop</Filename>
   <Filename>davinci-fairlight-studio-utility.desktop</Filename>
   <Filename>org.kde.drkonqi.coredump.gui.desktop</Filename>
   <Filename>davinci-control-panels-setup.desktop</Filename>
   <Filename>org.kde.plasma.emojier.desktop</Filename>
   <Filename>org.kde.kwrite.desktop</Filename>
   <Filename>nvim.desktop</Filename>
   <Filename>noisetorch.desktop</Filename>
  </Include>
 </Menu>
</Menu>
