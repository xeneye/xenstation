# Hermes Agent environment
#
# This file is copied automatically by NixOS to:
#
#   /etc/nixos/docker/ai/data/hermes/.env
#
# It is then available inside the container as:
#
#   /opt/data/.env
#
# Ollama is running locally on the Docker network and does not require
# authentication. Hermes still expects a non-empty API key for the
# custom OpenAI-compatible provider, so we use this local dummy value.

HERMES_CUSTOM_OLLAMA_11434_API_KEY=ollama-local
