# Copy to .env:
#   cp .env.example .env
# Compose mounts .env into the hermes container at /opt/data/.env.
#
# NOTE: There is no real secret needed here. Ollama runs locally and does
# not require authentication, but Hermes insists on having *something* in
# its api_key field, so we point it at this dummy value. Any non-empty
# string works — it is never sent anywhere except to your own Ollama.

HERMES_CUSTOM_OLLAMA_11434_API_KEY=ollama-local
